# Copier ce fichier en .env (jamais commité)
PORT=4000
# Origines autorisées (application des donneurs et plateforme)
CORS_ORIGINES=http://localhost:3000,http://localhost:3001
# Supabase : Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=a-remplir
JWT_SECRET=a-remplir
# WhatsApp Business (Cloud API)
WHATSAPP_TOKEN=a-remplir
WHATSAPP_PHONE_NUMBER_ID=a-remplir
