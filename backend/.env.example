# Copier ce fichier en .env (jamais commité)
PORT=4000
# Origines autorisées (application des donneurs et plateforme)
CORS_ORIGINES=http://localhost:3000,http://localhost:3001
# PostgreSQL — Neon (serverless). Utiliser l'URL « pooled » (suffixe -pooler)
# pour limiter les connexions TCP depuis les fonctions serverless :
#   postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# (l'option ?sslmode=require est obligatoire chez Neon).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Jeton d'authentification (générer une valeur aléatoire longue)
JWT_SECRET=a-remplir
JWT_EXPIRES=7d
# WhatsApp Business (Cloud API) — laissés vides en développement (les codes sont journalisés)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
