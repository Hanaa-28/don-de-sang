# Copier ce fichier en .env.local
# true  = l'espace agent utilise le simulateur et les exemples JSON du contrat
# false = il appelle le vrai backend (à activer route par route, à mesure
#         qu'elles sont livrées par Zozerigué — voir packages/contrat-api)
NEXT_PUBLIC_UTILISER_EXEMPLES=true
NEXT_PUBLIC_API_URL=http://localhost:4000
